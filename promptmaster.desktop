[Desktop Entry]
Version=1.0
Type=Application
Name=PromptMaster Studio
GenericName=Prompt Engineering & Meta-Optimization Studio
Comment=Sovereign AI Prompt Engineering, Optimization, Linting & Red Teaming Studio
Exec=/usr/local/bin/promptmaster desktop
Icon=promptmaster
Terminal=false
Categories=Development;System;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open PromptMaster CLI
Exec=x-terminal-emulator -e "/usr/local/bin/promptmaster --help"

[Desktop Action Web]
Name=Open Web UI (Port 8123)
Exec=/usr/local/bin/promptmaster web
